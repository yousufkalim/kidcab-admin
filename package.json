{
  "name": "kidcab-admin-panel",
  "version": "1.2.1",
  "description": "Dashboard built in react for kidcab by FalconConsulting.fr",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falconitconsultant/Kidcab-Admin.git"
  },
  "author": "Usman Haider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/falconitconsultant/Kidcab-Admin/issues"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile:scss": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.css",
    "minify:scss": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.min.css --output-style compressed",
    "map:scss": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.css --source-map true",
    "build:scss": "npm run compile:scss && npm run minify:scss && npm run map:scss",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "axios": "^0.24.0",
    "bootstrap": "4.6.0",
    "chart.js": "^2.9.4",
    "classnames": "2.3.1",
    "date-fns": "^2.29.3",
    "file-saver": "^2.0.5",
    "i18next": "^21.9.1",
    "i18next-browser-languagedetector": "^6.1.5",
    "jsonwebtoken": "^8.5.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.23",
    "moment": "^2.29.1",
    "node-sass-package-importer": "5.3.2",
    "nouislider": "15.2.0",
    "postcss-loader": "^7.0.1",
    "react": "17.0.2",
    "react-autocomplete": "^1.8.1",
    "react-big-calendar": "0.39.0",
    "react-chartjs-2": "2.11.1",
    "react-copy-to-clipboard": "5.0.3",
    "react-datepicker": "^4.8.0",
    "react-day-picker": "^7.4.10",
    "react-dom": "17.0.2",
    "react-error-overlay": "^6.0.11",
    "react-i18next": "^11.18.5",
    "react-paginate": "^8.1.2",
    "react-router-dom": "5.2.0",
    "react-scripts": "^5.0.1",
    "react-select": "^5.2.1",
    "react-time-picker": "^4.5.0",
    "react-toastify": "^8.1.0",
    "reactstrap": "8.9.0",
    "sass": "^1.54.8",
    "socket.io-client": "^4.4.1",
    "xlsx": "^0.18.0"
  },
  "devDependencies": {
    "eslint-config-react-app": "^7.0.1",
    "gulp": "4.0.2",
    "gulp-append-prepend": "1.0.9",
    "husky": "^8.0.0",
    "prettier": "^2.7.1",
    "pretty-quick": "^3.1.3"
  },
  "optionalDependencies": {
    "eslint-plugin-flowtype": "5.8.0",
    "jquery": "3.6.0",
    "typescript": "4.3.5"
  }
}
